NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/services
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/services
